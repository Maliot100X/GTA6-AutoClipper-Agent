# Copy to .env (install.sh does this) and fill in. Never commit .env.
# Official YouTube Data API v3 key (search / live / video stats). https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Supadata transcripts + metadata. https://supadata.ai
SUPADATA_API_KEY=
# Postpone scheduling (MCP endpoint https://api.postpone.app/mcp). https://www.postpone.app
POSTPONE_API_KEY=
# Firecrawl web scraping / search. https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# Optional: Zernio, vidIQ and TubeAlfred are used as MCP connectors inside your agent (Grok Bot / Claude), no key needed here.
